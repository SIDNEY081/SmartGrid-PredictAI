{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "smartgrid-dashboard",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["dashboard/app.py"],
      "port": 5000
    },
    {
      "name": "smartgrid-streamlit",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "streamlit", "run", "dashboard/streamlit_app.py", "--server.port", "8501", "--server.headless", "true"],
      "port": 8501
    }
  ]
}
